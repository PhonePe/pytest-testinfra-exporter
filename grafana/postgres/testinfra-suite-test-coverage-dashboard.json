          "uid": "${ds}"
        },
        "definition": "SELECT r.run_id AS __value, CASE WHEN r.run_name = TO_CHAR(r.started_at, 'YYYY-MM-DD HH24:MI:SS') THEN r.run_name ELSE CONCAT(r.run_name, ' (', TO_CHAR(r.started_at, 'YYYY-MM-DD HH24:MI:SS'), ')') END AS __text FROM test_runs r WHERE r.started_at BETWEEN (TO_TIMESTAMP(${__from}/1000.0) AT TIME ZONE 'Asia/Kolkata') AND (TO_TIMESTAMP(${__to}/1000.0) AT TIME ZONE 'Asia/Kolkata') AND EXISTS (SELECT 1 FROM test_results tr JOIN tests t ON t.id = tr.test_id WHERE tr.run_id = r.run_id AND ('${suite}' = '' OR t.test_suite = ${suite:sqlstring}) AND ('${test:csv}' = '__all' OR t.canonical_nodeid = ANY(string_to_array('${test:csv}', ',')))) ORDER BY r.started_at DESC",
