        "options": [],
        "query": "SELECT DISTINCT t.test_suite AS __value, t.test_suite AS __text, (t.test_suite)::text AS __ord0 FROM tests t JOIN test_results tr ON tr.test_id = t.id JOIN test_runs r ON r.run_id = tr.run_id WHERE t.test_suite IS NOT NULL AND t.test_suite <> '' AND r.started_at BETWEEN (TO_TIMESTAMP(${__from}/1000.0) AT TIME ZONE 'Asia/Kolkata') AND (TO_TIMESTAMP(${__to}/1000.0) AT TIME ZONE 'Asia/Kolkata') ORDER BY __ord0",
