      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "${ds}"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  TO_CHAR(r.started_at, 'YYYY-MM-DD HH24:MI:SS') AS started_at,\n  h.host_name,\n  t.canonical_nodeid,\n  t.test_name,\n  LOWER(tr.status) AS status,\n  CASE WHEN LOWER(tr.status) IN ('fail', 'error') THEN tr.failure_tag END AS failure_tag,\n  tr.duration_ms,\n  r.run_id,\n  t.id AS test_id\nFROM test_results tr\nJOIN test_runs r ON r.run_id = tr.run_id\nJOIN hosts h ON h.id = tr.host_id\nJOIN tests t ON t.id = tr.test_id\nWHERE r.started_at BETWEEN\n  (TO_TIMESTAMP(${__from}/1000.0) AT TIME ZONE 'Asia/Kolkata')\n  AND (TO_TIMESTAMP(${__to}/1000.0) AT TIME ZONE 'Asia/Kolkata')\n  AND ('${suite}' = '' OR t.test_suite = ${suite:sqlstring})\n  AND ('${test:csv}' = '__all' OR t.canonical_nodeid = ANY(string_to_array('${test:csv}', ',')))\n  AND ('${run_id:csv}' = '__all' OR r.run_id = ANY(string_to_array('${run_id:csv}', ',')))\nORDER BY r.started_at DESC, h.host_name, t.canonical_nodeid;",
          "refId": "A"
        }
      ],
      "title": "Test Results",
      "type": "table"
